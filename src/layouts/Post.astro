---
import Base from './Base.astro';
import CodeEnhance from '../components/CodeEnhance.astro';
import { formatDate, isoDate, slugifyTag } from '../lib';
interface Props {
  title: string; summary: string; date: Date; updated?: Date;
  tags: string[]; draft: boolean; minutes?: number;
  backHref: string; backLabel: string; tagBase?: string;
}
const { title, summary, date, updated, tags, draft, minutes, backHref, backLabel, tagBase } = Astro.props;
---
<Base title={title} description={summary} type="article" publishedTime={date}>
  <article class="container">
    <header class="post-head measure">
      <p class="back"><a href={backHref}>← {backLabel}</a></p>
      {draft && <p class="draft-note">Draft: only visible in local preview.</p>}
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        {updated && <> · Updated <time datetime={isoDate(updated)}>{formatDate(updated)}</time></>}
        {minutes && <> · {minutes} min read</>}
      </p>
      {tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {tags.map((t) => <li>{tagBase ? <a class="tag" href={`${tagBase}${slugifyTag(t)}/`}>{t}</a> : <span class="tag">{t}</span>}</li>)}
        </ul>
      )}
    </header>
    <slot name="before" />
    <div class="prose">
      <slot />
    </div>
    <slot name="after" />
  </article>
  <CodeEnhance />
</Base>

<style>
  .post-head { margin-bottom: 3rem; }
  .post-head h1 { margin: 1.5rem 0 1rem; font-size: clamp(2.2rem, 1.5rem + 3vw, 3.5rem); }
  .back { font-family: var(--font-sans); font-size: 0.9rem; margin: 0; }
  .back a { display: inline-block; background: var(--card); color: var(--text); text-decoration: none; border-radius: 999px; padding: 0.3rem 0.85rem; }
  .back a:hover { background: var(--invert-bg); color: var(--invert-text); }
  .post-head .meta { margin: 0 0 0.75rem; }
  .post-head .meta a { color: var(--text-muted); text-decoration: none; }
  .post-head .meta a:hover { color: var(--accent); }
  .draft-note { margin-top: 1rem; font-family: var(--font-sans); font-size: 0.85rem; color: var(--text); border: 1px dashed var(--text-muted); border-radius: var(--radius); padding: 0.4rem 0.75rem; display: inline-block; }
</style>
