---
/** <Callout type="note|warning">…</Callout> — a highlighted aside inside a post. */
interface Props { type?: 'note' | 'warning'; title?: string }
const { type = 'note', title } = Astro.props;
---
<aside class={`callout ${type}`}>
  {title && <p class="callout-title">{title}</p>}
  <slot />
</aside>
<style>
  .callout { border-left: 3px solid var(--text); background: var(--card); padding: 1rem 1.25rem; margin: 2rem 0; border-radius: 0 var(--radius) var(--radius) 0; font-size: 0.98em; }
  .callout.warning { border-left-color: #b8860b; }
  .callout :global(p:last-child) { margin-bottom: 0; }
  .callout-title { font-family: var(--font-sans); font-weight: 600; font-size: 0.9rem; margin-bottom: 0.4rem; }
</style>
