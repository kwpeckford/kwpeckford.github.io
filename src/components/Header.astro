---
import { SITE, NAV } from '../site';
import ThemeToggle from './ThemeToggle.astro';
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container bar">
    <a class="mark" href="/" aria-label={`${SITE.title}, home`}>
      <span class="mono" aria-hidden="true">KP</span>
      <span class="name">{SITE.title}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {NAV.map((item) => (
          <li><a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="right">
      <a class="arrow-link contact" href="/about/#contact">Get in touch</a>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .bar { display: flex; align-items: center; gap: 1rem 2.5rem; min-height: 5rem; font-family: var(--font-sans); flex-wrap: wrap; }
  .mark { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--text); text-decoration: none; }
  .mono {
    display: inline-grid; place-items: center; width: 2.1rem; height: 2.1rem; border-radius: 50%;
    background: var(--invert-bg); color: var(--invert-text); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.02em;
  }
  .name { font-weight: 500; font-size: 0.95rem; }
  nav ul { display: flex; gap: clamp(1rem, 3vw, 2rem); list-style: none; margin: 0; padding: 0; }
  nav a { color: var(--text); text-decoration: none; font-size: 0.95rem; opacity: 0.75; }
  nav a:hover { opacity: 1; }
  nav a[aria-current='page'] { opacity: 1; text-decoration: underline; text-underline-offset: 0.45em; }
  .right { margin-left: auto; display: flex; align-items: center; gap: 0.75rem; }
  @media (max-width: 640px) {
    .name { display: none; }
    .contact { display: none; }
    .bar { gap: 1rem 1.25rem; }
  }
</style>
