---
import type { Post } from '../lib';
import { formatDate, isoDate } from '../lib';
interface Props { posts: Post[]; showSummary?: boolean }
const { posts, showSummary = true } = Astro.props;
---
<ol class="post-list">
  {posts.map((post) => (
    <li>
      <div class="main">
        <a class="title" href={`/writing/${post.id}/`}>{post.data.title}</a>
        <p class="date"><time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>{post.data.draft && <span class="draft">Draft</span>}</p>
      </div>
      {showSummary && <p class="summary">{post.data.summary}</p>}
      {post.data.tags.length > 0 && (
        <ul class="tags" aria-label="Tags">{post.data.tags.map((t) => <li><span class="tag">{t}</span></li>)}</ul>
      )}
    </li>
  ))}
</ol>

<style>
  .post-list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--rule); }
  .post-list > li {
    position: relative; display: grid; gap: 0.5rem 2rem; padding: 1.75rem 0;
    border-bottom: 1px solid var(--rule); font-family: var(--font-sans);
  }
  @media (min-width: 860px) {
    .post-list > li { grid-template-columns: 1.15fr 1fr auto; align-items: start; }
    .tags { justify-content: flex-end; max-width: 14rem; }
  }
  .title { font-size: 1.3rem; font-weight: 450; letter-spacing: -0.02em; line-height: 1.3; color: var(--text); text-decoration: none; }
  .title::after { content: ''; position: absolute; inset: 0; }
  li:hover .title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .date { margin: 0.4rem 0 0; font-size: 0.9rem; color: var(--text-muted); }
  .date::before { content: '•'; margin-right: 0.5rem; }
  .summary { margin: 0; color: var(--text-muted); font-size: 0.98rem; line-height: 1.6; }
  .tags { position: relative; z-index: 1; }
  .draft { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--invert-text); background: var(--invert-bg); border-radius: 999px; padding: 0.1rem 0.5rem; margin-left: 0.6rem; }
</style>
