---
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { getPosts, readingTime, type Post as PostEntry } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props as { post: PostEntry };
const { Content } = await render(post);
---
<Post {...post.data} minutes={readingTime(post.body)} backHref="/writing/" backLabel="All writing" tagBase="/writing/tags/">
  <Content />
</Post>
