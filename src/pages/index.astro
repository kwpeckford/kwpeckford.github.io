---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { getPosts, getProjects } from '../lib';
import { SITE } from '../site';

const posts = (await getPosts()).slice(0, 3);
const featured = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);

// Optional portrait: drop a file named portrait.jpg (or .png/.webp) into src/assets/.
const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.{jpg,jpeg,png,webp}', { eager: true });
const portrait = Object.values(portraits)[0]?.default;
---
<Base>
  <div class="container">
    <section class={`hero ${portrait ? 'with-photo' : ''}`}>
      <p class="side" aria-hidden="true"><span>Incentive compensation · {SITE.location}</span></p>
      <div class="copy">
        <h1>Hi, I’m Kitchener<span class="dot">.</span></h1>
        <p class="intro">
          I help companies determine why and how to pay their employees commissions. Above that,
          I build the actual data model that services it, and all of the other pieces behind it.
        </p>
        <p class="curious">I’m incredibly curious, and I don’t stop thinking about things.</p>
        <p class="links">
          <a class="arrow-link" href="/writing/">Read the writing</a>
          <a class="arrow-link" href="/about/">More about me</a>
        </p>
      </div>
      {portrait && <Image src={portrait} alt={`Portrait of ${SITE.author}`} widths={[240, 320]} sizes="(max-width: 860px) 240px, 340px" format="webp" class="photo" loading="eager" />}
    </section>

    <section class="lately" aria-label="Lately">
      <div>
        <p class="label">On my mind</p>
        <p>How AI is changing the landscape of everything we do.</p>
      </div>
      <div>
        <p class="label">Working on</p>
        <p>Helping small businesses automate pieces of their business and look at their analytics.</p>
      </div>
      <div>
        <p class="label">Off the clock</p>
        <p>Ball hockey twice a week, bikes, and just keeping active.</p>
      </div>
    </section>

    <section aria-labelledby="latest">
      <header class="section-head">
        <div>
          <p class="eyebrow">Writing</p>
          <h2 id="latest">Latest writing</h2>
        </div>
        <div>
          <p>Essays on AI and the way we work, technical write-ups, and the occasional personal story.</p>
          <a class="arrow-link" href="/writing/">All writing</a>
        </div>
      </header>
      {posts.length ? <PostList posts={posts} /> : <p class="meta">Nothing published yet.</p>}
    </section>

    {featured.length > 0 && (
      <section aria-labelledby="projects">
        <header class="section-head">
          <div>
            <p class="eyebrow">Projects</p>
            <h2 id="projects">Things I’ve built</h2>
          </div>
          <div>
            <p>Side projects, tools and experiments, each with notes on why and how it was made.</p>
            <a class="arrow-link" href="/projects/">All projects</a>
          </div>
        </header>
        <ProjectGrid projects={featured} />
      </section>
    )}
  </div>
</Base>

<style>
  .hero { position: relative; display: grid; gap: 2rem; align-items: end; padding: clamp(1rem, 4vw, 3rem) 0 clamp(1rem, 3vw, 2rem); }
  @media (min-width: 860px) { .hero { padding-left: 4.5rem; } }
  .hero.with-photo { grid-template-columns: 1fr; }
  @media (min-width: 860px) { .hero.with-photo { grid-template-columns: 1.3fr 1fr; } }
  .side {
    display: none; position: absolute; left: 0; top: 0; bottom: 0; margin: 0;
    writing-mode: vertical-rl; transform: rotate(180deg);
    font-family: var(--font-sans); font-size: 0.8rem; color: var(--text-muted); letter-spacing: 0.04em;
  }
  .side span { display: flex; align-items: center; gap: 1rem; }
  .side span::before { content: ''; width: 1px; height: 6rem; background: var(--rule); }
  @media (min-width: 860px) { .side { display: block; } }
  h1 { font-size: clamp(3rem, 1.8rem + 5vw, 6rem); font-weight: 300; letter-spacing: -0.05em; line-height: 1; margin: 0 0 1.75rem; }
  .dot { color: var(--accent); }
  .curious { font-family: var(--font-sans); color: var(--text-muted); margin: 0 0 1.75rem; }
  .intro { font-family: var(--font-sans); font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem); line-height: 1.55; max-width: 40ch; margin: 0 0 1rem; }
  .links { display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; }
  /* Transparent cut-out portrait standing on the hero's bottom rule. */
  .hero.with-photo { padding-bottom: 0; border-bottom: 1px solid var(--rule); }
  .hero.with-photo .copy { padding-bottom: clamp(2rem, 5vw, 4rem); }
  .photo { display: block; width: 100%; max-width: 340px; height: auto; justify-self: end; align-self: end; }
  @media (max-width: 859px) { .photo { justify-self: center; max-width: 240px; } }
  .lately { display: grid; gap: 1.5rem 2.5rem; padding: 2rem 0 0; font-family: var(--font-sans); }
  @media (min-width: 760px) { .lately { grid-template-columns: repeat(3, 1fr); } }
  .lately p { margin: 0; font-size: 0.98rem; line-height: 1.55; }
  .lately .label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); margin-bottom: 0.4rem; font-weight: 550; }
</style>
